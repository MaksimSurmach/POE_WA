exports[`failure-state matrix > matches the 'invalid-recipe' component snapshot 1`] = `"<div class="failure-state" data-error-code="RECIPE_INVALID"><div class="alert alert--danger status-panel status-panel--danger" data-slot="alert-root" role="alert"><div class="alert__indicator" data-slot="alert-indicator"><svg aria-hidden="true" fill="none" height="16" role="presentation" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg" data-slot="alert-default-icon"><path clip-rule="evenodd" d="M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-4.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0M8.75 5a.75.75 0 0 0-1.5 0v2.5a.75.75 0 0 0 1.5 0z" fill="currentColor" fill-rule="evenodd"></path></svg></div><div class="alert__content" data-slot="alert-content"><h2 class="alert__title">Recipe configuration is invalid</h2><div class="alert__description">The recipe content is invalid. Correct the recipe source and run catalog sync again.</div></div></div></div>"`;

exports[`failure-state matrix > matches the 'no-data' component snapshot 1`] = `"<div class="alert alert--accent status-panel status-panel--info" data-slot="alert-root" role="status"><div class="alert__indicator" data-slot="alert-indicator"><svg aria-hidden="true" fill="none" height="16" role="presentation" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg" data-slot="alert-default-icon"><path clip-rule="evenodd" d="M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-9.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0m-.25 3a.75.75 0 0 0-1.5 0V11a.75.75 0 0 0 1.5 0z" fill="currentColor" fill-rule="evenodd"></path></svg></div><div class="alert__content" data-slot="alert-content"><h2 class="alert__title">No market data yet</h2><div class="alert__description">This recipe is queued for its first market evaluation. The page will update after a successful refresh.</div></div></div>"`;

exports[`failure-state matrix > matches the 'partial-no-listings' component snapshot 1`] = `"<div class="failure-state" data-error-code="NO_LISTINGS"><div class="alert alert--warning status-panel status-panel--warning" data-slot="alert-root" role="status"><div class="alert__indicator" data-slot="alert-indicator"><svg aria-hidden="true" fill="none" height="16" role="presentation" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg" data-slot="alert-default-icon"><path clip-rule="evenodd" d="M7.134 2.994L2.217 11.5a1 1 0 0 0 .866 1.5h9.834a1 1 0 0 0 .866-1.5L8.866 2.993a1 1 0 0 0-1.732 0m3.03-.75c-.962-1.665-3.366-1.665-4.329 0L.918 10.749c-.963 1.666.24 3.751 2.165 3.751h9.834c1.925 0 3.128-2.085 2.164-3.751zM8 5a.75.75 0 0 1 .75.75v2a.75.75 0 0 1-1.5 0v-2A.75.75 0 0 1 8 5m1 5.75a1 1 0 1 1-2 0a1 1 0 0 1 2 0" fill="currentColor" fill-rule="evenodd"></path></svg></div><div class="alert__content" data-slot="alert-content"><h2 class="alert__title">No market listings yet</h2><div class="alert__description">No matching market listings are available. Craft cost remains visible; sale price and profit are withheld.</div></div></div></div>"`;

exports[`failure-state matrix > matches the 'stale-provider' component snapshot 1`] = `"<div class="failure-state" data-error-code="PROVIDER_UNAVAILABLE"><div class="alert alert--warning status-panel status-panel--warning" data-slot="alert-root" role="status"><div class="alert__indicator" data-slot="alert-indicator"><svg aria-hidden="true" fill="none" height="16" role="presentation" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg" data-slot="alert-default-icon"><path clip-rule="evenodd" d="M7.134 2.994L2.217 11.5a1 1 0 0 0 .866 1.5h9.834a1 1 0 0 0 .866-1.5L8.866 2.993a1 1 0 0 0-1.732 0m3.03-.75c-.962-1.665-3.366-1.665-4.329 0L.918 10.749c-.963 1.666.24 3.751 2.165 3.751h9.834c1.925 0 3.128-2.085 2.164-3.751zM8 5a.75.75 0 0 1 .75.75v2a.75.75 0 0 1-1.5 0v-2A.75.75 0 0 1 8 5m1 5.75a1 1 0 1 1-2 0a1 1 0 0 1 2 0" fill="currentColor" fill-rule="evenodd"></path></svg></div><div class="alert__content" data-slot="alert-content"><h2 class="alert__title">Market provider temporarily unavailable</h2><div class="alert__description">The market provider is temporarily unavailable. Automatic refresh will retry; existing results remain visible. <span class="failure-state__timestamp">Last successful evaluation: <time dateTime="2026-07-18T00:01:00.000Z">Jul 18, 2026, 12:01 AM UTC</time>.</span></div></div></div></div>"`;
