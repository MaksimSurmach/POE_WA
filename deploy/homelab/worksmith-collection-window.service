[Unit]
Description=Enforce Worksmith seasonal collection window
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/worksmith/collection-window.env
ExecStart=/usr/bin/python3 /opt/worksmith/collection-window/collection-window.py
TimeoutStartSec=150
UMask=0077
