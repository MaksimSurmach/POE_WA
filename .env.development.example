APP_ENV=development
APP_MODE=api
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=debug
NINJA_USER_AGENT="POEWorksmith/0.1 (contact: https://github.com/MaksimSurmach/POE_WA/issues)"
REFRESH_CRON="0 * * * *"
REFRESH_TIMEZONE=UTC
CLEANUP_CRON="15 2 * * *"
POE_LEAGUE=Mercenaries
POE_USER_AGENT="OAuth poe-worksmith/0.0.0 (contact: local-development)"
POE_REQUEST_TIMEOUT_MS=15000
MARKET_CONCURRENCY=4
MARKET_COLLECTION_SOURCE=manual-import
